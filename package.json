    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "colyseus.js": "^0.16.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
