{
  "name": "arena-duel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/server --filter ./apps/client dev",
    "build": "pnpm -r build",
